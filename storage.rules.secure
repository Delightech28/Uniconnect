rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Default: deny all
    match /{allPaths=**} {
      allow read, write, delete: if false;
    }

    // User avatars: owner can write, anyone can read
    match /avatars/{userId}/{allPaths=**} {
      allow read: if true;
      allow write, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Public listing images: creator can write, anyone can read
    match /listings/{listingId}/{allPaths=**} {
      allow read: if true;
      allow write, delete: if request.auth != null;
    }

    // User documents: owner can write, only owner can read
    match /documents/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Study materials: anyone can read public, creator can write
    match /studyMaterials/{materialId}/{allPaths=**} {
      allow read: if true; // Public study materials
      allow write, delete: if request.auth != null;
    }

    // Chat attachments: participants only
    match /chats/{conversationId}/{allPaths=**} {
      allow read, write, delete: if request.auth != null;
    }

    // Profile images: owner can write, anyone can read
    match /profiles/{userId}/{allPaths=**} {
      allow read: if true;
      allow write, delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
