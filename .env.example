# ─── UniConnect — Environment Variables Template ───────────────────────────────
# Copy this file to .env and fill in real values locally.
# NEVER commit .env to version control (it is in .gitignore).

# ── Firebase client config (public — safe for browser) ─────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ── App domain (used for verification email links) ──────────────────────────────
VITE_APP_DOMAIN=https://www.yourdomain.com

# ── Firebase App Check — reCAPTCHA v3 ──────────────────────────────────────────
# 1. Register your app in Firebase Console → App Check
# 2. Choose reCAPTCHA v3 and copy the SITE KEY here
# 3. In the App Check console, click "Enforce" for Firestore / Storage / Functions
# Leave blank to disable App Check (not recommended in production)
VITE_RECAPTCHA_SITE_KEY=

# ── EmailJS (public key only — safe for browser) ────────────────────────────────
# Service ID and Template ID are config values, not secrets.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
#
# ⚠️  EmailJS PRIVATE KEY → Cloud Function Secret (NOT here)
# Never put the private key in .env. Store it in Firebase Secret Manager:
#   firebase functions:secrets:set EMAILJS_PRIVATE_KEY
# The sendVerificationEmail Cloud Function reads it at runtime.

# ── AI provider (optional) ──────────────────────────────────────────────────────
VITE_AI_PROVIDER=claude-haiku-4.5
VITE_CLAUDE_API_KEY=
VITE_CLAUDE_MODEL=claude-haiku-4.5

# ─── Secrets that live in Firebase Secret Manager (NOT in .env) ────────────────
# Set these once via the Firebase CLI:
#   firebase functions:secrets:set PAYSTACK_SECRET_KEY
#   firebase functions:secrets:set GEMINI_API_KEY
#   firebase functions:secrets:set EMAILJS_PRIVATE_KEY
# These are never exposed to the browser or committed to the repo.
